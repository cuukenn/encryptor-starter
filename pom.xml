<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.cuukenn</groupId>
    <artifactId>encryptor-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>encryptor</name>
    <description>encrypt and decrypt data</description>
    <url>https://github.com/cuukenn/encryptor-starter</url>
    <properties>
        <rversion>${version}</rversion>
        <!-- *************************maven基础配置*************************************-->
        <!--maven编译的JDK版本和编码字符集-->
        <java.version>8</java.version>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <!-- *************************三方依赖版本号**************************************-->
        <spring-boot.version>2.7.18</spring-boot.version>
        <spring-cloud.version>2021.0.8</spring-cloud.version>
        <spring-cloud-alibaba.version>2021.1</spring-cloud-alibaba.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!--
                先导入本项目 BOM：Maven 的 dependencyManagement 是“先声明者胜”。
                Spring Boot / Spring Cloud 的 BOM 也会管理 nimbus-jose-jwt（较旧版本，含已知 CVE），
                放在后面才能让本项目的 9.37.3 / BouncyCastle / Hutool 版本对下游模块生效。
            -->
            <dependency>
                <groupId>io.github.cuukenn</groupId>
                <artifactId>encryptor-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--spring cloud依赖控制-->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--spring cloud alibaba依赖控制-->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>cuukenn</id>
            <name>cuukenn</name>
            <email>cgg244@qq.com</email>
            <url>https://github.com/cuukenn</url>
            <timezone>+8</timezone>
            <roles>
                <role>Architect</role>
                <role>Developer</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git@github.com:cuukenn/encryptor-starter.git</connection>
        <developerConnection>scm:git:git@github.com:cuukenn/encryptor-starter.git</developerConnection>
        <url>https://github.com/cuukenn/encryptor-starter</url>
    </scm>
    <issueManagement>
        <system>Github Issue</system>
        <url>https://github.com/cuukenn/encryptor-starter/issues</url>
    </issueManagement>
    <profiles>
        <profile>
            <id>all-modules</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <module>encryptor-dependencies</module>
                <module>encryptor-core</module>
                <module>encryptor-sm</module>
                <module>encryptor-starters</module>
                <module>encryptor-examples</module>
                <module>encryptor-bench</module>
            </modules>
        </profile>
        <profile>
            <id>main-module</id>
            <modules>
                <module>encryptor-dependencies</module>
                <module>encryptor-core</module>
                <module>encryptor-sm</module>
                <module>encryptor-starters</module>
            </modules>
        </profile>
        <!--
            Boot3 双线工程（SRP: Multi Boot 版本支持）：显式激活 `-Pboot3` 后，
            javax 线既有 profiles（all-modules/main-module）与 boot3 互不重叠，
            两条产品线各自独立构建。
            版本锚点（2026-10 时点，均为 Spring 官方 3.5.16 / 2025.0.3 / SCA 2025.0.0.0 的最终 OSS release）：
            属性覆写是首选路径 —— 根 pom 的 BOM import 用 ${spring-boot.version} 等插值，
            boot3 模块一旦加入，其 effective model 会以本 profile 提供的属性值解析（spike 见 task 执行记录）。
        -->
        <profile>
            <id>boot3</id>
            <properties>
                <spring-boot.version>3.5.16</spring-boot.version>
                <spring-cloud.version>2025.0.3</spring-cloud.version>
                <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>
                <maven.compiler.source>17</maven.compiler.source>
                <maven.compiler.target>17</maven.compiler.target>
                <java.version>17</java.version>
            </properties>
            <modules>
                <module>encryptor-starters/encryptor-spring-boot3-starter</module>
                <module>encryptor-starters/encryptor-web-boot3-starter</module>
            </modules>
        </profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                    </plugin>
                    <!-- GPG plugin -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                    </plugin>
                    <!-- 发布走 Maven Central Portal：旧 OSSRH（s01.oss.sonatype.org）staging 已下线 -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
            <distributionManagement>
                <snapshotRepository>
                    <id>sonatype</id>
                    <url>https://s01.oss.sonatype.org/content/repositories/snapshots/</url>
                </snapshotRepository>
                <repository>
                    <id>sonatype</id>
                    <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
                </repository>
            </distributionManagement>
        </profile>
    </profiles>
    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <resources>
            <resource>
                <!--将bootstrap配置文件列入maven变量替换范围-->
                <directory>${basedir}/src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/bootstrap*.yml</include>
                </includes>
            </resource>
            <resource>
                <!--将bootstrap配置文件之外的文件也列为资源文件进行打包-->
                <directory>${basedir}/src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/bootstrap*.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <pluginManagement>
            <plugins>
                <!--  单元测试：JUnit5 需要 surefire 2.22+，Maven 默认的 2.12.x 不会执行 JUnit5 测试-->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>2.22.2</version>
                    <configuration>
                        <!-- HttpTest 是需要先启动服务的端到端脚本，不属于单元测试 -->
                        <excludes>
                            <exclude>**/HttpTest.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <!--  javadoc-->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.7.0</version>
                    <configuration>
                        <show>package</show>
                        <tags>
                            <tag>
                                <name>date</name>
                            </tag>
                        </tags>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                            <configuration>
                                <doclint>none</doclint>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <!-- Source -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.2.1</version>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!--  sonatype-->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                    <configuration>
                        <gpgArguments>
                            <argument>--pinentry-mode</argument>
                            <argument>loopback</argument>
                        </gpgArguments>
                    </configuration>
                    <executions>
                        <execution>
                            <id>sign-artifacts</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>sign</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!--  Maven Central Portal 发布（取代已下线的 OSSRH staging） -->
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.12.0</version>
                    <extensions>true</extensions>
                    <configuration>
                        <!-- settings.xml 里 id=central 的 server（Portal user token） -->
                        <publishingServerId>central</publishingServerId>
                        <!-- 与旧 autoReleaseAfterClose=false 同义：上传+校验后留在 Portal，人工点 Publish -->
                        <autoPublish>false</autoPublish>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!--
                构建环境基线：JDK / Maven 版本与重复依赖声明在位即可拦截。
                刻意不开 dependencyConvergence：本项目依赖 Spring Boot / Spring Cloud 的传递依赖树，
                收敛失败往往是上游版本组合问题，需要先确认期望版本再决定是否纳入门禁。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.6,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[1.8,)</version>
                                </requireJavaVersion>
                                <banDuplicatePomDependencyVersions/>
                                <!--
                                    Spring Boot / Spring Cloud 的 BOM 也会管理 nimbus-jose-jwt（较旧版本，含已知 CVE）。
                                    根 POM 已把本项目 BOM 前置；这条规则防止以后调整顺序时又回落到旧版本。
                                -->
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.nimbusds:nimbus-jose-jwt:[0,9.37.3)</exclude>
                                        <!--
                                            旧 BC 系（jdk15on）由 spring-security-rsa 等传递引入，会与
                                            encryptor-sm 的 jdk18on 形成同名包冲突；网关 starter 已排除。
                                            这里再加一道门禁，防止后续依赖调整把它带回来。
                                        -->
                                        <exclude>org.bouncycastle:*-jdk15on</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>