<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
        boot3 线示例（Task 2 验证工程 gateway-boot3-verify 转正，SRP: Multi Boot 版本支持）：
        SCG（spring-cloud-starter-gateway 2025.0.x）+ gateway-boot3 复制线（3.0.0）
        + reactive/micrometer 共享线（1.0.0，Task 2 裁定共享）。
        parent 自带 spring-boot-starter-parent（版本锚点 3.5.16，与根 pom boot3 profile 一致），
        示例不参与发布（不走 encryptor-parent 的 release 插件链）；
        经根 pom 的 boot3 profile 纳入 reactor（-Pboot3 构建，需 JDK 17）。
        下游复用 javax 线 gateway-example/web 的同一形态：普通应用（不带 encryptor）、
        独立进程端口 8082（本示例内置 JDK HttpServer 回显实现，README 说明两种起法）。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>io.github.cuukenn.encryptor</groupId>
    <artifactId>boot3-gateway-example</artifactId>
    <version>1.0.0</version>
    <name>boot3-gateway-example</name>
    <description>Boot 3.5 网关示例：gateway-boot3 复制线 + reactive/micrometer 共享线</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>2025.0.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <!-- Step 1：gateway-boot3 复制线（Boot 3 专用，版本 3.0.0 与 Boot 3 代际对齐） -->
        <dependency>
            <groupId>io.github.cuukenn</groupId>
            <artifactId>encryptor-gateway-boot3-starter</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- Step 2：micrometer 指标适配（Task 2 裁定共享 1.0.0：原 jar 在 Boot 3.5 直接可用） -->
        <dependency>
            <groupId>io.github.cuukenn</groupId>
            <artifactId>encryptor-micrometer-spring-boot-starter</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>boot3-gateway-example</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- 可执行 jar（java -jar）：parent 的 pluginManagement 已固定版本，这里声明即启用 repackage -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
