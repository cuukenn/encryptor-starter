<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
        一次性验证工程（Task 2 决策型 spike）：javax 代共享 jar（1.0.0）
        在 Boot 3.5 + SCG 2025.0 运行时的行为验证。
        ✅ 不属于 any 根 reactor profile（all-modules/main-module/boot3 均未列举本模块），
        独立构建：mvn（JDK17）-f encryptor-examples/gateway-boot3-verify/pom.xml test
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>io.github.cuukenn.encryptor</groupId>
    <artifactId>gateway-boot3-verify</artifactId>
    <version>1.0.0</version>
    <name>gateway-boot3-verify</name>
    <description>共享 jar 的 Boot 3.5 行为验证工程（reactive/gateway/micrometer 三个候选）</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <task2-boot.version>3.5.16</task2-boot.version>
        <task2-spring-cloud.version>2025.0.3</task2-spring-cloud.version>
        <!-- 共享候选 jar：先 install 主 reactor（mvn -Pmain-module install），再引用本地 1.0.0 -->
        <task2-encryptor.version>1.0.0</task2-encryptor.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${task2-spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 验证目标一：SCG 过滤器（风险点 1/2 的本体） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
        <!-- 验证目标三：MetricsAutoConfiguration 与 MeterRegistry（风险点 3 的语义锚） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 共享候选：reactive 通用装配（javax 代 1.0.0 main-module install 产物） -->
        <dependency>
            <groupId>io.github.cuukenn</groupId>
            <artifactId>encryptor-spring-boot-starter-reactive</artifactId>
            <version>${task2-encryptor.version}</version>
        </dependency>
        <!-- 共享候选：网关过滤器 -->
        <dependency>
            <groupId>io.github.cuukenn</groupId>
            <artifactId>encryptor-gateway-spring-boot-starter</artifactId>
            <version>${task2-encryptor.version}</version>
        </dependency>
        <!-- 共享候选：micrometer 指标 -->
        <dependency>
            <groupId>io.github.cuukenn</groupId>
            <artifactId>encryptor-micrometer-spring-boot-starter</artifactId>
            <version>${task2-encryptor.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
