<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.cuukenn</groupId>
        <artifactId>encryptor-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>encryptor-core</artifactId>
    <name>encryptor-core</name>
    <packaging>jar</packaging>
    <description>Encryptor Core</description>
    <dependencies>
        <!--
            JOSE/JWE 编解码（新协议的唯一密码学依赖）。
            版本仍显式固定：即使未来有人调整 parent 的 BOM 顺序，core 也不会回落到 Spring Boot
            管理的 9.1.3（CVE-2023-1370 嵌套 JSON 解析栈溢出、CVE-2023-52428 等）。
            本协议会解析客户端提交的 JWE 头（不受信输入），因此必须保持在 9.37.3。
        -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>9.37.3</version>
        </dependency>
        <!--
            国密（SM2/SM4-GCM）已迁到独立的 encryptor-sm 模块；core 保持零 BouncyCastle 依赖。
            SM2 用户需显式添加 io.github.cuukenn:encryptor-sm（版本由 BOM 管理）。
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
