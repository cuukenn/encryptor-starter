    <description>Encryptor starters</description>
    <modules>
        <module>encryptor-starter</module>
        <module>encryptor-starter-reactive</module>
        <module>encryptor-web-starter</module>
        <module>encryptor-gateway-starter</module>
        <module>encryptor-micrometer-starter</module>
    </modules>
</project>
