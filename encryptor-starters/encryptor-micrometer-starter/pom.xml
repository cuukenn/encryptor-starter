<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.cuukenn</groupId>
        <artifactId>encryptor-starters</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>encryptor-micrometer-spring-boot-starter</artifactId>
    <name>encryptor-micrometer-spring-boot-starter</name>
    <description>可选的 Micrometer 指标适配：加解密计数与失败分类、网关密码学执行器队列深度（D1/D3）</description>
    <dependencies>
        <dependency>
            <groupId>io.github.cuukenn</groupId>
            <artifactId>encryptor-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <!-- 只为网关侧 CryptoExecutor 队列深度指标；servlet 应用不该被动引入 Spring Cloud Gateway -->
            <groupId>io.github.cuukenn</groupId>
            <artifactId>encryptor-gateway-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
