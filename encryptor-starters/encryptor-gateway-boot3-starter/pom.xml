<!--
    boot3 双线工程（javax 线 encryptor-gateway-spring-boot-starter 的 jakarta 复制对，Task 2 裁定：复制）：
    共享 jar 在 Boot 3.5/SCG 2025.0 下会字节码级 NoSuchMethodError——
    Spring 6.2 移除了 ServerHttpRequest#getMethodValue()（4 处调用点）且
    ServerHttpResponse#getStatusCode() 返回类型改为 HttpStatusCode（3 处），机械包名替换修不了，
    故本模块在逐字节复制基础上对 3 个过滤器类做最小签名适配（语义零变更，
    由 scripts/javax-to-jakarta.sh 的 expect-diff 登记守卫，见 Task 5 执行记录）。
    - reactive 通用装配（encryptor-spring-boot-starter-reactive）与 micrometer 适配共享 1.0.0，不建复制模块。
    - 版本自管 3.0.0（parent 仍为 encryptor-starters 1.0.0），仅在 -Pboot3 下构建：
      Spring Boot/Cloud/SCA 版本由根 pom 的 boot3 profile 属性锚定（3.5.16/2025.0.3/2025.0.0.0）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.cuukenn</groupId>
        <artifactId>encryptor-starters</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>encryptor-gateway-boot3-starter</artifactId>
    <version>3.0.0</version>
    <name>encryptor-gateway-boot3-starter</name>
    <description>Encryptor Spring Cloud Gateway Boot 3 Starter</description>
    <packaging>jar</packaging>
    <!--
        显式 dependencyManagement 兜底：根 pom 的 BOM import 用 ${project.version} 插值，
        本模块自管版本 3.0.0 后会误解析为 encryptor-dependencies:3.0.0（不存在），
        这里固定回 BOM 实际版本 1.0.0（reactive 共享对位解析为 1.0.0；Spring 版本仍锚定 boot3 profile 属性）。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.cuukenn</groupId>
                <artifactId>encryptor-dependencies</artifactId>
                <version>1.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                网关 starter 自管 SCG 依赖面（模块内自含，同 boot3 复制线的 BOM 兜底分工）：
                SC 2025.0.x 火车把 spring-cloud-dependencies 里的 gateway 版本委托给
                spring-cloud-gateway-dependencies（5.0 起正名 gateway-server-webflux，
                旧名 spring-cloud-starter-gateway 只剩 deprecated 别名被击穿到下一大版本移除），
                boot3 复制线按新坐标声明；这里 import 4.3.5（= SC 2025.0.3 火车锚定的
                gateway 4.3.5）让依赖单独从仓库解析时也有受管版本（不再报 POM invalid）。
                复盘 SC/gateway patch 时同步这里的锚。
            -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-gateway-dependencies</artifactId>
                <version>4.3.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <!-- reactive 通用装配是共享模块（Task 2 裁定）：boot3 线直接消费 1.0.0，不复制 -->
        <dependency>
            <groupId>io.github.cuukenn</groupId>
            <artifactId>encryptor-spring-boot-starter-reactive</artifactId>
        </dependency>
        <!-- gateway 侧使用 hutool 的 JSONUtil；core 不再传递该依赖 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-json</artifactId>
        </dependency>
        <!-- 网关转发面（SCG webflux）：正名坐标 spring-cloud-starter-gateway-server-webflux，
             版本由上方 spring-cloud-gateway-dependencies:4.3.5 受管（-Pboot3 reactor 与
             仓库单独解析同口径）。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
            <!--
                spring-cloud-starter -> spring-security-rsa 会传递 BC 1.69（jdk15on）。
                网关链路不使用 spring-security-rsa；这里排除旧 BC 系，避免与用户显式添加的
                encryptor-sm（BC 1.78.1 / jdk18on）在 classpath 上出现两套同名包。
            -->
            <exclusions>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcpkix-jdk15on</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcprov-jdk15on</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcutil-jdk15on</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 国密用例：SM 套件/解析器是可选模块，测试侧显式添加（不会被 starter 传给消费者） -->
        <dependency>
            <groupId>io.github.cuukenn</groupId>
            <artifactId>encryptor-sm</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!--
                boot3 线以 release 17 编译（javax 线为 Java 8）：显式 pin 插件版本 + release，
                不依赖 Maven 默认值。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <!--
                Boot3 线的 JUnit 平台（随 Boot 3.5.16）需要与 surefire 自带的
                junit-platform-launcher 对齐，surefire 2.22.2 会报
                OutputDirectoryProvider not available（Jupiter engine 无法发现测试），
                显式升级到 3.x；excludes 保持与根 pom 约定一致 (HttpTest 需要先启动服务)。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <excludes>
                        <exclude>**/HttpTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
